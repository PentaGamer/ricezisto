{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " 󰄾 "
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "keyColor": "35"
    },
    {
      "type": "os",
      "key": "󰌽 OS",
      "keyColor": "34"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel",
      "keyColor": "34"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "33"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "33"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "35"
    },
    {
      "type": "de",
      "key": "󰧨 DE",
      "keyColor": "35"
    },
    {
      "type": "wm",
      "key": "󱂬 WM",
      "keyColor": "35"
    },
    {
      "type": "terminal",
      "key": "󰞍 Terminal",
      "keyColor": "36"
    },
    {
      "type": "terminalfont",
      "key": "󰛖 Font",
      "keyColor": "36"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory",
      "keyColor": "32"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
