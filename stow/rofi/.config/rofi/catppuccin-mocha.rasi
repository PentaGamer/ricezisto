/* ==============================================================================
 * Ricezisto - Rofi Catppuccin Mocha Mauve Theme
 * ============================================================================== */

* {
    bg-col:  #1e1e2e;
    bg-col-light: #1e1e2e;
    border-col: #cba6f7;
    selected-col: #313244;
    mauve: #cba6f7;
    fg-col: #cdd6f4;
    fg-col-selected: #cba6f7;
    fg-muted: #6c7086;
    width: 600px;
    font: "Inter 11";
}

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 400px;
    border: 2px;
    border-color: @border-col;
    border-radius: 16px;
    background-color: @bg-col;
    padding: 10px;
}

mainbox {
    background-color: @bg-col;
    children: [inputbar, listview, mode-switcher];
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col;
    border-radius: 10px;
    padding: 4px;
    margin: 6px 6px 10px 6px;
}

prompt {
    background-color: @mauve;
    padding: 8px 14px;
    text-color: #11111b;
    border-radius: 8px;
    margin: 0px 8px 0px 0px;
    font: "Inter Bold 11";
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 8px 12px;
    margin: 0px 0px 0px 0px;
    text-color: @fg-col;
    background-color: @selected-col;
    border-radius: 8px;
    placeholder: "Pesquisar...";
    placeholder-color: @fg-muted;
}

listview {
    border: 0px 0px 0px;
    padding: 4px;
    margin: 0px 6px 6px 6px;
    columns: 1;
    lines: 7;
    background-color: @bg-col;
}

element {
    padding: 8px 12px;
    margin: 2px 0px;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 10px;
}

element-icon {
    size: 24px;
    margin: 0px 10px 0px 0px;
}

element selected {
    background-color: @selected-col;
    text-color: @fg-col-selected;
    border: 1px;
    border-color: rgba(203, 166, 247, 0.4);
}

mode-switcher {
    spacing: 10px;
    margin: 6px 6px 6px 6px;
}

button {
    padding: 6px 10px;
    background-color: @selected-col;
    text-color: @fg-muted;
    vertical-align: 0.5; 
    horizontal-align: 0.5;
    border-radius: 8px;
}

button selected {
    background-color: @mauve;
    text-color: #11111b;
}
