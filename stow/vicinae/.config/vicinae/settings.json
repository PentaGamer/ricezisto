{
  "$schema": "https://vicinae.com/schemas/config.json",
  "close_on_focus_loss": true,
  "consider_preedit": false,
  "activate_on_single_click": true,
  "wrap_navigation": true,
  "escape_key_behavior": "close_window",
  "pop_to_root_on_close": true,
  "favicon_service": "twenty",
  "font": {
    "rendering": "qt",
    "normal": {
      "family": "Inter",
      "size": 10.5
    }
  },
  "theme": {
    "dark": {
      "name": "catppuccin-mocha-mauve",
      "icon_theme": "Papirus-Dark"
    },
    "light": {
      "name": "catppuccin-mocha-mauve",
      "icon_theme": "Papirus-Dark"
    }
  },
  "launcher_window": {
    "opacity": 0.98,
    "material": "blur",
    "rounding": 14,
    "clock": {
      "enabled": false
    },
    "client_side_decorations": {
      "enabled": true,
      "border_width": 1,
      "shadow_size": 16
    },
    "compact_mode": {
      "enabled": false
    },
    "size": {
      "width": 750,
      "height": 450
    },
    "layer_shell": {
      "enabled": false
    }
  },
  "favorites": [
    "applications:kitty",
    "applications:org.gnome.Nautilus",
    "applications:brave-browser"
  ],
  "fallbacks": [],
  "providers": {
    "applications": {
      "enabled": true
    },
    "clipboard": {
      "enabled": true
    },
    "calculator": {
      "enabled": false
    },
    "core": {
      "enabled": false
    },
    "developer": {
      "enabled": false
    },
    "files": {
      "enabled": false
    },
    "font": {
      "enabled": false
    },
    "manage-shortcuts": {
      "enabled": false
    },
    "power": {
      "enabled": false
    },
    "raycast-compat": {
      "enabled": false
    },
    "snippets": {
      "enabled": false
    },
    "system": {
      "enabled": false
    },
    "theme": {
      "enabled": false
    },
    "wm": {
      "enabled": false
    }
  }
}
